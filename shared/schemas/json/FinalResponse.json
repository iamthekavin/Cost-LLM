{
  "$defs": {
    "ModelCallResult": {
      "additionalProperties": true,
      "description": "Contract C: Model Gateway execution output per subtask.",
      "properties": {
        "subtask_id": {
          "description": "Identifier corresponding to the executed subtask",
          "title": "Subtask Id",
          "type": "string"
        },
        "model_used": {
          "description": "Actual model that completed the execution",
          "title": "Model Used",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "description": "Prompt/input token count",
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "description": "Completion/output token count",
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0.0,
          "description": "End-to-end execution latency in milliseconds",
          "minimum": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "cost_usd": {
          "default": 0.0,
          "description": "Calculated monetary cost in USD",
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "raw_output": {
          "description": "Model generated text response",
          "title": "Raw Output",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Error message if execution failed",
          "title": "Error"
        }
      },
      "required": [
        "subtask_id",
        "model_used",
        "raw_output"
      ],
      "title": "ModelCallResult",
      "type": "object"
    },
    "ModelTier": {
      "description": "Model tier representing cost/capability profile.",
      "enum": [
        "local",
        "cheap",
        "premium"
      ],
      "title": "ModelTier",
      "type": "string"
    },
    "ReasoningDepth": {
      "description": "Reasoning depth required for a prompt or subtask.",
      "enum": [
        "trivial",
        "moderate",
        "deep"
      ],
      "title": "ReasoningDepth",
      "type": "string"
    },
    "RoutingDecision": {
      "additionalProperties": true,
      "description": "Contract B: Router Core decision for each (sub)task.",
      "properties": {
        "request_id": {
          "description": "Parent request identifier",
          "title": "Request Id",
          "type": "string"
        },
        "subtask_id": {
          "description": "Identifier for this specific subtask",
          "title": "Subtask Id",
          "type": "string"
        },
        "subtask_text": {
          "description": "Actual text sent to the chosen model",
          "title": "Subtask Text",
          "type": "string"
        },
        "complexity_score": {
          "description": "Estimated reasoning complexity between 0.0 (trivial) and 1.0 (frontier deep reasoning)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Complexity Score",
          "type": "number"
        },
        "reasoning_depth": {
          "$ref": "#/$defs/ReasoningDepth",
          "description": "Categorical reasoning depth (trivial, moderate, deep)"
        },
        "chosen_model": {
          "description": "Identifier of model selected for execution (e.g., llama3.1:8b, gpt-4o-mini, gpt-4o)",
          "title": "Chosen Model",
          "type": "string"
        },
        "chosen_tier": {
          "$ref": "#/$defs/ModelTier",
          "description": "Tier of the chosen model (local, cheap, premium)"
        },
        "routing_reason": {
          "description": "Short human-readable rationale explaining why this model/tier was selected",
          "title": "Routing Reason",
          "type": "string"
        },
        "fallback_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Designated secondary model if chosen_model times out or fails",
          "title": "Fallback Model"
        },
        "overridden_by_user": {
          "default": false,
          "description": "True if an explicit user or admin override dictated chosen_model",
          "title": "Overridden By User",
          "type": "boolean"
        },
        "timestamp": {
          "description": "UTC timestamp when the routing decision was made",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "subtask_id",
        "subtask_text",
        "complexity_score",
        "reasoning_depth",
        "chosen_model",
        "chosen_tier",
        "routing_reason"
      ],
      "title": "RoutingDecision",
      "type": "object"
    },
    "SubtaskBreakdownItem": {
      "additionalProperties": true,
      "description": "Pairing of a RoutingDecision and its corresponding ModelCallResult.",
      "properties": {
        "subtask_id": {
          "description": "Subtask identifier",
          "title": "Subtask Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/RoutingDecision",
          "description": "Routing decision for this subtask"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCallResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Execution result from Model Gateway"
        }
      },
      "required": [
        "subtask_id",
        "decision"
      ],
      "title": "SubtaskBreakdownItem",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Contract D: Merged output returned to the original caller.",
  "properties": {
    "request_id": {
      "description": "Original request identifier",
      "title": "Request Id",
      "type": "string"
    },
    "final_answer": {
      "description": "Synthesized, merged final response text",
      "title": "Final Answer",
      "type": "string"
    },
    "subtask_breakdown": {
      "description": "Per-subtask execution audit (RoutingDecision + ModelCallResult)",
      "items": {
        "$ref": "#/$defs/SubtaskBreakdownItem"
      },
      "title": "Subtask Breakdown",
      "type": "array"
    },
    "total_cost_usd": {
      "default": 0.0,
      "description": "Summed monetary cost of all subtasks in USD",
      "minimum": 0.0,
      "title": "Total Cost Usd",
      "type": "number"
    },
    "total_latency_ms": {
      "default": 0.0,
      "description": "End-to-end request latency in milliseconds",
      "minimum": 0.0,
      "title": "Total Latency Ms",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "final_answer"
  ],
  "title": "FinalResponse",
  "type": "object"
}