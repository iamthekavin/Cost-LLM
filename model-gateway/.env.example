# Cost-LLM Model Gateway Environment Configuration

# Local Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=llama3.1:8b

# Hosted Provider API Keys (Read from environment only, never committed)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway Server Configuration
GATEWAY_PORT=8002
GATEWAY_HOST=0.0.0.0
LOG_LEVEL=INFO

# Timeout & Retries
DEFAULT_HOSTED_TIMEOUT_SECONDS=30.0
DEFAULT_LOCAL_TIMEOUT_SECONDS=60.0
MAX_HOSTED_RETRIES=2
RETRY_INITIAL_DELAY_SECONDS=0.5
